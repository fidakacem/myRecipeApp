pipeline {
    agent any

    triggers {
        // Vérifie toutes les minutes si un nouveau tag est créé
        pollSCM('* * * * *')
    }

    environment {
        // Variable pour stocker le tag détecté
        VERSION = ''
    }

    stages {

        stage('Detect Tag') {
            steps {
                script {
                    // Récupère le dernier tag Git depuis le dépôt
                    VERSION = bat(script: 'git describe --tags --abbrev=0', returnStdout: true).trim()
                    echo "Tag détecté : ${VERSION}"

                    if (!VERSION) {
                        error "Ce pipeline doit être lancé avec un tag Git (ex: v1.0.7)"
                    }

                    env.VERSION = VERSION
                }
            }
        }

        stage('Checkout') {
            steps {
                checkout([$class: 'GitSCM',
                    branches: [[name: "refs/tags/${env.VERSION}"]],
                    userRemoteConfigs: [[
                        url: 'https://github.com/fidakacem/myRecipeApp.git',
                        credentialsId: 'github'
                    ]]
                ])
            }
        }

        stage('Setup') {
            steps {
                bat 'npm install --force'
            }
        }

        stage('Build') {
            steps {
                bat 'npm run build'
            }
        }

        stage('Docker Build Versionné') {
            steps {
                bat """
                    docker build -t recettes-app:${env.VERSION} .
                """
            }
        }

        stage('Run Docker') {
            steps {
                bat """
                    docker run -d -p 3000:80 --name version_container recettes-app:${env.VERSION}
                """
                sleep 5
            }
        }

        stage('Smoke Test') {
            steps {
                bat 'smoke-test.bat > smoke-version-log.txt'
            }
        }

        stage('Archive Artifacts') {
            steps {
                archiveArtifacts artifacts: '*.txt', fingerprint: true
            }
        }

        stage('Report') {
            steps {
                echo "Build versionné terminé pour ${env.VERSION}"
            }
        }
    }

    post {
        always {
            echo "Cleaning up..."
            bat """
                docker rm -f version_container || echo container removed
                docker rmi recettes-app:${env.VERSION} || echo image removed
            """
        }
    }
}