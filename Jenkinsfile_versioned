pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Detect Tag') {
            steps {
                script {

                    // Récupérer tous les tags
                    bat 'git fetch --tags --force'

                    // Obtenir le dernier tag
                    def output = bat(
                        returnStdout: true,
                        script: 'git describe --tags --abbrev=0'
                    ).trim()

                    // Filtrer uniquement la ligne correspondant au tag
                    def rawTag = output
                        .split('\\r?\\n')
                        .find { it ==~ /v[0-9]+\\.[0-9]+\\.[0-9]+/ }

                    if (!rawTag) {
                        error "Unable to detect TAG from output: ${output}"
                    }

                    echo "Detected TAG: ${rawTag}"
                    env.VERSION = rawTag
                }
            }
        }

        stage('Build ZIP') {
            steps {
                script {
                    def zipName = "release-${env.VERSION}.zip"
                    echo "Creating ZIP: ${zipName}"

                    // Compression via PowerShell
                    bat """
                        powershell -Command "Compress-Archive -Path * -DestinationPath '${zipName}' -Force"
                    """
                }
            }
        }

        stage('Archive Artifact') {
            steps {
                archiveArtifacts artifacts: '*.zip', fingerprint: true
            }
        }
    }

    post {
        success {
            echo "Build OK for version ${env.VERSION}"
        }
        failure {
            echo "Build FAILED"
        }
    }
}