pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Detect Tag') {
            steps {
                script {
                    // Assurer la récupération de tous les tags Git
                    bat 'git fetch --tags --force'

                    // Récupération du dernier tag
                    def rawTag = bat(
                        script: 'git describe --tags --abbrev=0',
                        returnStdout: true
                    ).trim()

                    env.VERSION = rawTag.replaceAll('[\r\n]+', '')
                    echo "Tag détecté : ${env.VERSION}"

                    if (!env.VERSION || env.VERSION == "null") {
                        error "❌ Aucun tag Git détecté. Le job doit être déclenché via un tag."
                    }
                }
            }
        }

        stage('Build ZIP Versionné') {
            steps {
                script {
                    // Nom du fichier ZIP
                    def zipName = "release-${env.VERSION}.zip"

                    echo "Création de l’archive : ${zipName}"

                    // Construction du ZIP
                    bat """
                        powershell Compress-Archive -Path * -DestinationPath ${zipName} -Force
                    """

                    echo "Archive générée : ${zipName}"
                }
            }
        }

        stage('Archive Artifact') {
            steps {
                archiveArtifacts artifacts: "*.zip", fingerprint: true
            }
        }
    }

    post {
        success {
            echo "✅ Build complété avec succès : Version ${env.VERSION}"
        }
        failure {
            echo "❌ Build échoué."
        }
    }
}