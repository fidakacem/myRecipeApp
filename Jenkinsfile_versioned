pipeline {
    agent any

    parameters {
        string(name: 'TAG_NAME', defaultValue: '', description: 'Tag Git à construire (ex: v1.0.7)')
    }

    environment {
        VERSION = "${params.TAG_NAME}"
    }

    stages {

        stage('Check Tag') {
            steps {
                script {
                    if (!params.TAG_NAME) {
                        error "Ce pipeline doit être lancé avec un tag Git (ex: v1.0.7)"
                    }
                    echo "Tag détecté : ${params.TAG_NAME}"
                }
            }
        }

        stage('Checkout') {
            steps {
                checkout([$class: 'GitSCM',
                    branches: [[name: "refs/tags/${params.TAG_NAME}"]],
                    userRemoteConfigs: [[
                        url: 'https://github.com/fidakacem/myRecipeApp.git',
                        credentialsId: 'github'
                    ]]
                ])
            }
        }

        stage('Setup') {
            steps {
                bat 'npm install --force'
            }
        }

        stage('Build') {
            steps {
                bat 'npm run build'
            }
        }

        stage('Docker Build Versionné') {
            steps {
                bat """
                    docker build -t recettes-app:${params.TAG_NAME} .
                """
            }
        }

        stage('Run Docker') {
            steps {
                bat """
                    docker run -d -p 3000:80 --name version_container recettes-app:${params.TAG_NAME}
                """
                sleep 5
            }
        }

        stage('Smoke Test') {
            steps {
                bat 'smoke-test.bat > smoke-version-log.txt'
            }
        }

        stage('Archive Artifacts') {
            steps {
                archiveArtifacts artifacts: '*.txt', fingerprint: true
            }
        }

        stage('Report') {
            steps {
                echo "Build versionné terminé pour ${params.TAG_NAME}"
            }
        }
    }

    post {
        always {
            echo "Cleaning up..."
            bat """
                docker rm -f version_container || echo container removed
                docker rmi recettes-app:${params.TAG_NAME} || echo image removed
            """
        }
    }
}