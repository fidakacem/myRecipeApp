pipeline {
    agent any

    environment {
        IMAGE_NAME = "recettes-app"
        CONTAINER_NAME_BASE = "versioned-app"
    }

    stages {

        /* 1 - CHECKOUT */
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        /* 2 - DETECT TAG via Jenkins (fiable à 100%) */
        stage('Detect Tag') {
            steps {
                script {

                    if (!env.TAG_NAME) {
                        error " Ce pipeline doit être déclenché SEULEMENT par un tag vX.Y.Z !"
                    }

                    // Exemple TAG_NAME = "v1.0.27"
                    env.VERSION = env.TAG_NAME

                    echo "Tag détecté : ${env.VERSION}"

                    // Conteneur unique
                    env.CONTAINER_NAME = "${CONTAINER_NAME_BASE}-${VERSION.replace('.', '-').toLowerCase()}"

                    echo "Nom du conteneur : ${env.CONTAINER_NAME}"
                }
            }
        }

        /* 3 - SETUP */
        stage('Setup') {
            steps {
                bat 'npm install --force'
            }
        }

        /* 4 - BUILD */
        stage('Build') {
            steps {
                bat 'npm run build'
            }
        }

        /* 5 - DOCKER BUILD */
        stage('Docker Build') {
            steps {
                script {
                    bat "docker build -t ${IMAGE_NAME}:${env.VERSION} ."
                }
            }
        }

        /* 6 - RUN (Docker) */
        stage('Run Docker') {
            steps {
                script {
                    bat "docker rm -f ${env.CONTAINER_NAME} || echo OK"
                    bat "docker run -d -p 3000:80 --name ${env.CONTAINER_NAME} ${IMAGE_NAME}:${env.VERSION}"
                    sleep 5
                }
            }
        }

        /* 7 - SMOKE TEST */
        stage('Smoke Test') {
            steps {
                bat 'smoke-test.bat > smoke-log.txt'
            }
        }

        /* 8 - ARCHIVE */
        stage('Archive Artifacts') {
            steps {
                script {
                    def zipName = "release-${env.VERSION}.zip"
                    bat "powershell -Command \"Compress-Archive -Path * -DestinationPath '${zipName}' -Force\""
                }
                archiveArtifacts artifacts: '*.zip, smoke-log.txt', fingerprint: true
            }
        }

        /* 9 - CLEANUP */
        stage('Cleanup') {
            steps {
                bat "docker rm -f ${env.CONTAINER_NAME} || echo Container déjà supprimé"
                bat "docker image rm ${IMAGE_NAME}:${env.VERSION} || echo Image déjà supprimée"
            }
        }
    }

    post {
        success {
            echo " Build Versionné SUCCÈS : ${env.VERSION}"
        }
        failure {
            echo " Build Versionné ÉCHOUÉ"
        }
    }
}