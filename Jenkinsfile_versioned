pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Detect Tag') {
            steps {
                script {

                    // Fetch tags
                    bat(script: 'git fetch --tags --force')

                    // Detect last tag (NO cmd /c here!)
                    def rawTag = bat(
                        returnStdout: true,
                        script: 'git describe --tags --abbrev=0'
                    ).trim()

                    // Remove CRLF
                    rawTag = rawTag.replaceAll('[\\r\\n]+', '')

                    echo "Detected TAG: ${rawTag}"

                    if (!rawTag || rawTag == "null") {
                        error "No Git TAG detected"
                    }

                    env.VERSION = rawTag
                }
            }
        }

        stage('Build ZIP') {
            steps {
                script {
                    def zipName = "release-${env.VERSION}.zip"
                    echo "Creating ZIP: ${zipName}"

                    bat """
                        powershell -Command "Compress-Archive -Path * -DestinationPath '${zipName}' -Force"
                    """
                }
            }
        }

        stage('Archive Artifact') {
            steps {
                archiveArtifacts artifacts: '*.zip', fingerprint: true
            }
        }
    }

    post {
        success {
            echo "Build OK for version ${env.VERSION}"
        }
        failure {
            echo "Build FAILED"
        }
    }
}