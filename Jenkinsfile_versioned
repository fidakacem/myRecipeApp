pipeline {
    agent any

    environment {
        VERSION = ''
    }

    stages {

        stage('Detect Tag') {
            steps {
                script {
                    def rawTag = bat(
                        script: 'git describe --tags --abbrev=0',
                        returnStdout: true
                    ).trim()

                    // Nettoyer correctement
                    env.VERSION = rawTag.replaceAll('[\r\n]+', '')

                    echo "Tag détecté propre : ${env.VERSION}"

                    if (!env.VERSION) {
                        error "Aucun tag détecté. Ce job doit être lancé via un tag Git."
                    }
                }
            }
        }

        stage('Checkout') {
            steps {
                checkout([$class: 'GitSCM',
                    branches: [[name: "refs/tags/${env.VERSION}"]],
                    doGenerateSubmoduleConfigurations: false,
                    extensions: [],
                    userRemoteConfigs: [[
                        url: 'https://github.com/fidakacem/myRecipeApp.git',
                        credentialsId: 'github'
                    ]]
                ])
            }
        }

        stage('Setup') {
            steps {
                bat 'npm install --force'
            }
        }

        stage('Build') {
            steps {
                bat 'npm run build'
            }
        }

        stage('Docker Build Versionné') {
            steps {
                bat "docker build -t recettes-app:${env.VERSION} ."
            }
        }

        stage('Run Docker') {
            steps {
                bat "docker run -d -p 3000:80 --name version_container recettes-app:${env.VERSION}"
                sleep 5
            }
        }

        stage('Smoke Test') {
            steps {
                bat 'smoke-test.bat > smoke-version-log.txt'
            }
        }

        stage('Archive Artifacts') {
            steps {
                archiveArtifacts artifacts: '*.txt', fingerprint: true
            }
        }

        stage('Report') {
            steps {
                echo "Build versionné terminé pour ${env.VERSION}"
            }
        }
    }

    post {
        always {
            echo "Nettoyage Docker"
            bat """
                docker rm -f version_container || echo container removed
                docker rmi recettes-app:${env.VERSION} || echo image removed
            """
        }
        success {
            echo "Pipeline terminé avec succès pour le tag ${env.VERSION}"
        }
        failure {
            echo "Pipeline échoué pour le tag ${env.VERSION}"
        }
    }
}