pipeline {
    agent any

    triggers {
        githubPush()   // Déclenche automatiquement sur creation de TAG
    }

    stages {

        /* 1 — CHECKOUT */
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        /* 2 — Detect Tag */
        stage('Detect Tag') {
            steps {
                script {
                    // Récupération des tags
                    bat 'git fetch --tags --force'

                    def rawTag = bat(
                        returnStdout: true,
                        script: 'git describe --tags --abbrev=0'
                    ).trim()

                    // Nettoyer Windows \r
                    rawTag = rawTag.replace("\r","")

                    if (!(rawTag ==~ /v[0-9]+\.[0-9]+\.[0-9]+/)) {
                        error "Tag format invalid : ${rawTag}"
                    }

                    echo "Detected TAG = ${rawTag}"
                    env.VERSION = rawTag
                }
            }
        }

        /* 3 — Setup */
        stage('Setup') {
            steps {
                bat 'npm install --force'
            }
        }

        /* 4 — Build */
        stage('Build') {
            steps {
                bat 'npm run build'
            }
        }

        /* 5 — Docker Build */
        stage('Docker Build') {
            steps {
                bat "docker build -t recettes-app:${env.VERSION} ."
            }
        }

        /* 6 — Run Docker */
        stage('Run Docker') {
            steps {
                bat """
                    docker run -d -p 3002:80 --name versioned_container recettes-app:${env.VERSION}
                """
                sleep 5
            }
        }

        /* 7 — Smoke Test */
        stage('Smoke Test') {
            steps {
                bat 'smoke-test.bat > smoke-log.txt'
            }
        }

        /* 8 — Archive Artifacts */
        stage('Archive Artifacts') {
            steps {
                archiveArtifacts artifacts: '*.txt', fingerprint: true
                archiveArtifacts artifacts: "*.zip", fingerprint: true
            }
        }

        /* 9 — Build ZIP FINAL */
        stage("Package ZIP") {
            steps {
                script {
                    def zipName = "release-${env.VERSION}.zip"
                    bat """
                        powershell -Command "Compress-Archive -Path dist/* -DestinationPath '${zipName}' -Force"
                    """
                }
            }
        }
    }

    post {
        always {
            bat """
                docker rm -f versioned_container || echo container removed
                docker image rm recettes-app:${env.VERSION} || echo image removed
            """
        }
        success {
            echo " Versioned Build OK for ${env.VERSION}"
        }
        failure {
            echo " Versioned Build FAILED"
        }
    }
}