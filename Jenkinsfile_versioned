pipeline {
    agent any

    environment {
        VERSION = '' // Variable pour stocker le tag Git
    }

    // Décommenter si tu veux polling au lieu de webhook
    // triggers {
    //     pollSCM('* * * * *') // vérifie toutes les minutes
    // }

    stages {

        stage('Detect Tag') {
            steps {
                script {
                    // Récupère le tag Git depuis Jenkins (env.GIT_TAG_NAME) ou via git describe
                    VERSION = env.GIT_TAG_NAME ?: bat(script: 'git describe --tags --abbrev=0', returnStdout: true).trim()
                    echo "Tag détecté : ${VERSION}"

                    if (!VERSION) {
                        error "Ce pipeline doit être lancé avec un tag Git (ex: v1.0.11)"
                    }
                }
            }
        }

        stage('Checkout') {
            steps {
                checkout([$class: 'GitSCM',
                    branches: [[name: "refs/tags/${VERSION}"]],
                    doGenerateSubmoduleConfigurations: false,
                    extensions: [],
                    userRemoteConfigs: [[
                        url: 'https://github.com/fidakacem/myRecipeApp.git',
                        credentialsId: 'github' // ID de tes credentials GitHub
                    ]]
                ])
            }
        }

        stage('Setup') {
            steps {
                echo "Installation des dépendances npm"
                bat 'npm install --force'
            }
        }

        stage('Build') {
            steps {
                echo "Build de l'application React"
                bat 'npm run build'
            }
        }

        stage('Docker Build Versionné') {
            steps {
                echo "Création de l'image Docker versionnée"
                bat "docker build -t recettes-app:${VERSION} ."
            }
        }

        stage('Run Docker') {
            steps {
                echo "Lancement du container Docker versionné"
                bat "docker run -d -p 3000:80 --name version_container recettes-app:${VERSION}"
                sleep 5
            }
        }

        stage('Smoke Test') {
            steps {
                echo "Exécution des tests de fumée"
                bat 'smoke-test.bat > smoke-version-log.txt'
            }
        }

        stage('Archive Artifacts') {
            steps {
                echo "Archivage des artefacts"
                archiveArtifacts artifacts: '*.txt', fingerprint: true
            }
        }

        stage('Report') {
            steps {
                echo "Build versionné terminé pour ${VERSION}"
            }
        }
    }

    post {
        always {
            echo "Nettoyage Docker"
            bat """
                docker rm -f version_container || echo container removed
                docker rmi recettes-app:${VERSION} || echo image removed
            """
        }
        success {
            echo "Pipeline terminé avec succès pour le tag ${VERSION}"
        }
        failure {
            echo "Pipeline échoué pour le tag ${VERSION}"
        }
    }
}