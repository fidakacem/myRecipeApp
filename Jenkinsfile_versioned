pipeline {
    agent any

    environment {
        VERSION = ''
    }

    // Déclencheur webhook GitHub pour tags uniquement
    triggers {
        // Vide, webhook GitHub suffisant pour déclencher sur push de tag
    }

    stages {
        stage('Detect Tag') {
            steps {
                script {
                    // Récupère le tag Git à partir de l'environnement Jenkins
                    VERSION = env.GIT_TAG_NAME ?: bat(script: 'git describe --tags --abbrev=0', returnStdout: true).trim()
                    echo "Tag détecté : ${VERSION}"
                    
                    // Stop si aucun tag détecté
                    if (!VERSION) {
                        error "Ce pipeline doit être lancé avec un tag Git (ex: v1.0.10)"
                    }
                }
            }
        }

        stage('Checkout') {
            steps {
                checkout([$class: 'GitSCM',
                    branches: [[name: "refs/tags/${VERSION}"]],
                    userRemoteConfigs: [[
                        url: 'https://github.com/fidakacem/myRecipeApp.git',
                        credentialsId: 'github' // ID de tes credentials GitHub
                    ]]
                ])
            }
        }

        stage('Setup') {
            steps {
                bat 'npm install --force'
            }
        }

        stage('Build') {
            steps {
                bat 'npm run build'
            }
        }

        stage('Docker Build Versionné') {
            steps {
                bat "docker build -t recettes-app:${VERSION} ."
            }
        }

        stage('Run Docker') {
            steps {
                bat "docker run -d -p 3000:80 --name version_container recettes-app:${VERSION}"
                sleep 5
            }
        }

        stage('Smoke Test') {
            steps {
                bat 'smoke-test.bat > smoke-version-log.txt'
            }
        }

        stage('Archive Artifacts') {
            steps {
                archiveArtifacts artifacts: '*.txt', fingerprint: true
            }
        }

        stage('Report') {
            steps {
                echo "Build versionné terminé pour ${VERSION}"
            }
        }
    }

    post {
        always {
            echo "Cleaning up..."
            bat """
                docker rm -f version_container || echo container removed
                docker rmi recettes-app:${VERSION} || echo image removed
            """
        }
        success {
            echo "Pipeline terminé avec succès pour le tag ${VERSION}"
        }
        failure {
            echo "Pipeline échoué pour le tag ${VERSION}"
        }
    }
}