pipeline {
    agent any

    triggers {
        // Déclenchement automatique à chaque PUSH d’un TAG vX.Y.Z
        pollSCM('H/2 * * * *')
    }

    environment {
        IMAGE_NAME = "recettes-app"
        CONTAINER_NAME = "versioned_container"
    }

    stages {

        /* -----------------------------
         * 1) CHECKOUT
         * ----------------------------*/
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        /* -----------------------------
         * 2) DETECT TAG (vX.Y.Z)
         * ----------------------------*/
        stage('Detect Tag') {
            steps {
                script {
                    bat 'git fetch --tags --force'

                    def output = bat(
                        returnStdout: true,
                        script: 'git describe --tags --abbrev=0'
                    )

                    // Récupérer uniquement la ligne du tag
                    def tagLine = output.readLines().find { it ==~ /v[0-9]+\.[0-9]+\.[0-9]+/ }

                    if (!tagLine) {
                        error "No valid TAG found in output: ${output}"
                    }

                    tagLine = tagLine.replace("\r", "")
                    echo "Detected TAG: ${tagLine}"

                    env.VERSION = tagLine
                }
            }
        }

        /* -----------------------------
         * 3) SETUP
         * ----------------------------*/
        stage('Setup') {
            steps {
                bat 'npm install --force'
            }
        }

        /* -----------------------------
         * 4) BUILD FRONTEND
         * ----------------------------*/
        stage('Build') {
            steps {
                bat 'npm run build'
            }
        }

        /* -----------------------------
         * 5) BUILD DOCKER IMAGE VERSIONNEE
         * ----------------------------*/
        stage('Docker Build') {
            steps {
                script {
                    bat """
                        docker build -t ${IMAGE_NAME}:${env.VERSION} .
                    """
                }
            }
        }

        /* -----------------------------
         * 6) RUN DOCKER
         * ----------------------------*/
        stage('Run Docker') {
            steps {
                script {
                    bat """
                        docker run -d -p 3002:80 --name ${CONTAINER_NAME} ${IMAGE_NAME}:${env.VERSION}
                    """
                }
                sleep 5
            }
        }

        /* -----------------------------
         * 7) SMOKE TEST
         * ----------------------------*/
        stage('Smoke Test') {
            steps {
                bat 'smoke-test.bat > smoke-log.txt'
            }
        }

        /* -----------------------------
         * 😎 ARCHIVE ARTEFACTS
         * ----------------------------*/
        stage('Archive Artifacts') {
            steps {
                archiveArtifacts artifacts: '*.txt', fingerprint: true
            }
        }

        /* -----------------------------
         * 9) PACKAGE ZIP VERSIONNE
         * ----------------------------*/
        stage('Package ZIP') {
            steps {
                script {
                    def zipName = "release-${env.VERSION}.zip"

                    bat """
                        powershell -Command "Compress-Archive -Path * -DestinationPath '${zipName}' -Force"
                    """
                }
            }
        }

        /* -----------------------------
         * 10) ARCHIVE ZIP
         * ----------------------------*/
        stage('Archive ZIP') {
            steps {
                archiveArtifacts artifacts: '*.zip', fingerprint: true
            }
        }
    }

    /* -----------------------------
     * POST-ACTIONS CLEANUP
     * ----------------------------*/
    post {
        always {
            echo "Cleaning up..."

            bat """
                docker rm -f ${CONTAINER_NAME} || echo container removed
                docker image rm ${IMAGE_NAME}:${env.VERSION} || echo image removed
            """
        }

        success {
            echo "Versioned Build Success — Version ${env.VERSION}"
        }

        failure {
            echo "Versioned Build FAILED"
        }
    }
}