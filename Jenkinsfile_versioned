pipeline {
    agent any

    environment {
        VERSION = ''
    }

    triggers {
        
        // pollSCM('* * * * *')
    }

    stages {

        stage('Detect Tag') {
            steps {
                script {
                    // Récupère le tag déclencheur du build
                    if (env.GIT_TAG_NAME) {
                        VERSION = env.GIT_TAG_NAME
                    } else {
                        // Pour les pipelines classiques, récupère le dernier tag
                        VERSION = bat(script: 'git describe --tags --abbrev=0', returnStdout: true).trim()
                    }

                    echo "Tag détecté : ${VERSION}"

                    if (!VERSION) {
                        error "Ce pipeline doit être lancé avec un tag Git (ex: v1.0.9)"
                    }
                }
            }
        }

        stage('Setup') {
            steps {
                bat 'npm install --force'
            }
        }

        stage('Build') {
            steps {
                bat 'npm run build'
            }
        }

        stage('Docker Build Versionné') {
            steps {
                bat "docker build -t recettes-app:${VERSION} ."
            }
        }

        stage('Run Docker') {
            steps {
                bat "docker run -d -p 3000:80 --name version_container recettes-app:${VERSION}"
                sleep 5
            }
        }

        stage('Smoke Test') {
            steps {
                bat 'smoke-test.bat > smoke-version-log.txt'
            }
        }

        stage('Archive Artifacts') {
            steps {
                archiveArtifacts artifacts: '*.txt', fingerprint: true
            }
        }

        stage('Report') {
            steps {
                echo "Build versionné terminé pour ${VERSION}"
            }
        }
    }

    post {
        always {
            echo "Cleaning up..."
            bat """
                docker rm -f version_container || echo container removed
                docker rmi recettes-app:${VERSION} || echo image removed
            """
        }
    }
}