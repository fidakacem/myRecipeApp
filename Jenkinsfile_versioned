pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Detect Tag') {
            steps {
                script {
                    bat 'git fetch --tags --force'

                    def rawTag = bat(
                        script: 'git describe --tags --abbrev=0',
                        returnStdout: true
                    ).trim()

                    env.VERSION = rawTag.replaceAll('[\r\n]+', '')
                    echo "Tag detected: ${env.VERSION}"

                    if (!env.VERSION || env.VERSION == "null") {
                        error "No Git tag detected. Job must be triggered by a tag."
                    }
                }
            }
        }

        stage('Build ZIP') {
            steps {
                script {
                    def zipName = "release-${env.VERSION}.zip"
                    echo "Creating archive: ${zipName}"

                    bat """
                        powershell Compress-Archive -Path * -DestinationPath ${zipName} -Force
                    """

                    echo "Archive created: ${zipName}"
                }
            }
        }

        stage('Archive Artifact') {
            steps {
                archiveArtifacts artifacts: "*.zip", fingerprint: true
            }
        }
    }

    post {
        success {
            echo "Build success: Version ${env.VERSION}"
        }
        failure {
            echo "Build failed."
        }
    }
}