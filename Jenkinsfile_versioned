pipeline {
    agent any

    triggers {
        // Déclenchement automatique sur tags vX.Y.Z
        pollSCM('H/2 * * * *')
    }

    environment {
        VERSION = "${env.GIT_TAG_NAME}"
    }

    stages {

        stage('Check Tag') {
            steps {
                script {
                    if (!env.GIT_TAG_NAME) {
                        error "Ce pipeline ne s’exécute que sur TAG Git."
                    }
                    echo "Tag détecté : ${env.GIT_TAG_NAME}"
                }
            }
        }

        stage('Checkout') {
            steps {
                git credentialsId: 'github',
                    url: 'https://github.com/fidakacem/myRecipeApp.git'
            }
        }

        stage('Setup') {
            steps {
                bat 'npm install --force'
            }
        }

        stage('Build') {
            steps {
                bat 'npm run build'
            }
        }

        stage('Docker Build Versionné') {
            steps {
                bat """
                    docker build -t recettes-app:${env.GIT_TAG_NAME} .
                """
            }
        }

        stage('Run Docker') {
            steps {
                bat """
                    docker run -d -p 3000:80 --name version_container recettes-app:${env.GIT_TAG_NAME}
                """
                sleep 5
            }
        }

        stage('Smoke Test') {
            steps {
                bat 'smoke-test.bat > smoke-version-log.txt'
            }
        }

        stage('Archive Artifacts') {
            steps {
                archiveArtifacts artifacts: '*.txt', fingerprint: true
            }
        }

        stage('Report') {
            steps {
                echo "Build versionné terminé pour ${env.GIT_TAG_NAME}"
            }
        }
    }

    post {
        always {
            echo "Cleaning up..."
            bat '''
                docker rm -f version_container || echo container removed
                docker image rm recettes-app:%VERSION% || echo image removed
            '''
        }
    }
}