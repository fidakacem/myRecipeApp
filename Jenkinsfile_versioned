pipeline {
    agent any

    triggers {
        // Déclenchement automatique via Webhook GitHub
        githubPush()
    }

    stages {

        stage('Check Tag') {
            when { buildingTag() }
            steps {
                script {
                    echo "Tag détecté : ${env.GIT_TAG_NAME}"
                }
            }
        }

        stage('Checkout') {
            when { buildingTag() }
            steps {
                checkout([$class: 'GitSCM',
                    branches: [[name: "*/tags/${env.GIT_TAG_NAME}"]],
                    userRemoteConfigs: [[
                        url: 'https://github.com/fidakacem/myRecipeApp.git',
                        credentialsId: 'github'
                    ]]
                ])
            }
        }

        stage('Setup') {
            when { buildingTag() }
            steps {
                bat 'npm install --force'
            }
        }

        stage('Build') {
            when { buildingTag() }
            steps {
                bat 'npm run build'
            }
        }

        stage('Docker Build Versionné') {
            when { buildingTag() }
            steps {
                bat """
                    docker build -t recettes-app:${env.GIT_TAG_NAME} .
                """
            }
        }

        stage('Run Docker') {
            when { buildingTag() }
            steps {
                bat """
                    docker run -d -p 3000:80 --name version_container recettes-app:${env.GIT_TAG_NAME}
                """
                sleep 5
            }
        }

        stage('Smoke Test') {
            when { buildingTag() }
            steps {
                bat 'smoke-test.bat > smoke-version-log.txt'
            }
        }

        stage('Archive Artifacts') {
            when { buildingTag() }
            steps {
                archiveArtifacts artifacts: '*.txt', fingerprint: true
            }
        }

        stage('Report') {
            when { buildingTag() }
            steps {
                echo "Build versionné terminé pour ${env.GIT_TAG_NAME}"
            }
        }
    }

    post {
        always {
            echo "Cleaning up..."
            bat '''
                docker rm -f version_container || echo container removed
                docker image rm recettes-app:%VERSION% || echo image removed
            '''
        }
    }
}